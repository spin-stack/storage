// Qué proceso corre dónde, y qué le promete a quién. Fuente de diagrama_deployment_v6.svg.
//
// Se genera con `task diagrams`; el SVG es salida y no se edita a mano.
digraph G {
  rankdir=TB;
  bgcolor="white";
  labelloc="t";
  label="Deployment — v6";
  fontname="Arial"; fontsize=13;
  node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#334155",
        fontname="Arial", fontsize=12, margin="0.18,0.10"];
  edge [color="#475569", fontname="Arial", fontsize=10];

  cli [label="CLI / API client"];

  subgraph cluster_cp {
    label="Control Plane (uno elegido · toda mutación lleva guarda de term)";
    fontname="Arial"; fontsize=11; color="#94a3b8"; style=rounded;
    cp [label="control-plane\nprovision · place · clone · delete\nrebuild-metadata"];
    pg [label="PostgreSQL 18\ncatálogo: ownership, epoch, metadata\n(reconstruible desde el object store)"];
    cp -> pg [label="  sqlc / TLS"];
  }

  subgraph cluster_a {
    label="Host A";
    fontname="Arial"; fontsize=11; color="#94a3b8"; style=rounded;
    agentA  [label="volume-agent\nprepara la cadena · rota · publica · reconstruye"];
    runnerA [label="runner de spin\nlanza QEMU y es dueño de su ciclo de vida (ADR-0021)"];
    vmA     [label="VMs  ·  QEMU  ·  /dev/vda"];
    diskA   [label="NVMe local\nvolumes/<id>/layers/*.qcow2", fillcolor="#eef2f7"];
    runnerA -> vmA;
    vmA -> diskA [label="  I/O local"];
  }

  subgraph cluster_b {
    label="Host B — no es un standby: es otro host cualquiera";
    fontname="Arial"; fontsize=11; color="#94a3b8"; style=rounded;
    agentB [label="volume-agent"];
    diskB  [label="NVMe local\nvacío hasta que se le otorgue un volumen", fillcolor="#eef2f7"];
    agentB -> diskB [style=invis];
  }

  s3  [label="Object store (S3 o filesystem)\nlayers inmutables · manifests create-only · HEAD bajo CAS\nes la AUTORIDAD de lo que sobrevive a perder un host", fillcolor="#eef2f7"];
  kms [label="KMS / Vault\nla KEK de ESTE host (-kek-file)"];

  cli -> cp [label="  Connect/gRPC"];
  cp  -> agentA [label="  desired state · epoch\l  heartbeat cada N s → lease\l"];
  cp  -> agentB [label="  (mismo canal)"];
  cp  -> agentA [label="  GetVolumeKeys → la DEK ENVUELTA\l  (el CP nunca ve la KEK ni la clave en claro)\l", style=dashed];
  kms -> agentA [label="  desenvolver, atada al volumen\l  (una DEK de otro volumen no abre)\l", style=dashed];

  agentA -> runnerA [label="  el contrato son dos paths:\l  active/current (qué qcow2 abrir)\l  qmp.sock (dónde lo encuentra el Agent)\l", style=dashed];
  agentA -> s3 [label="  publica: layer → manifest → CAS de HEAD"];
  s3 -> agentB [label="  pierde el host A → B reconstruye la cadena\l  desde HEAD, sin nada local\l", style=dashed];
  s3 -> cp [label="  rebuild-metadata\l  (verifica cada descriptor con la KEK)\l", style=dashed, constraint=false];
}
