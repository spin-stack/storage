# Build output
/bin/
/_output/
/dist/

# Go
*.test
*.out


# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Coverage profiles
cover*.out

# Project-local pinned tool binaries (task tools)
/.tools/

# BuildKit cache + build output (task build:qemu)
/.cache/
/_output/
# ...and _output as a symlink. The trailing-slash form above matches directories
# only, so a worktree that symlinks _output at the primary checkout's build
# output shows it as an untracked *file* and the next `git add -A` commits the
# link — with an absolute path that means nothing on any other machine.
/_output

# Coverage intermediates
cover.raw
